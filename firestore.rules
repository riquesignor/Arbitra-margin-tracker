rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper — true se quem está logado tem `isAdmin == true` no PRÓPRIO
    // doc de perfil (users/{uid}). Centralizado aqui porque quase toda
    // regra abaixo precisa desse mesmo check (ver ADR-0003 — antes disso
    // cada match repetia o mesmo `get(...)` inline).
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Cada usuário só lê/escreve o próprio perfil. Admin também pode ler
    // e atualizar qualquer perfil — é o que sustenta a tela Admin (lista
    // de usuários + troca de plano), sem precisar de Admin SDK/Cloud
    // Function pra isso no MVP.
    //
    // Subcoleções (ver ADR-0003 — dado 1:N ou 1:1 por usuário que antes
    // vivia em coleções de nível superior filtradas/chaveadas por
    // `userId`, agora aninhado aqui dentro pra ficar "tudo na pasta do
    // usuário" no Console do Firebase, com o UID (nunca o nome de
    // exibição) como chave real de isolamento):
    // ⚠️ ESCALONAMENTO DE PRIVILÉGIO CORRIGIDO (set/2026) — antes esta
    // regra era `allow read, write: if isOwner(userId)`, ou seja, o dono
    // podia escrever QUALQUER campo do próprio perfil, inclusive
    // `isAdmin: true` e `plan: "pro"`. E são exatamente esses dois campos
    // que sustentam (a) o helper isAdmin() aqui em cima, (b) o gate de
    // admin do servidor (api/_lib/adminAuth.ts > requireAdmin) e (c) a
    // liberação da biblioteca por plano (shared_catalogs, mais abaixo).
    // Bastava um setDoc no console do navegador pra qualquer conta virar
    // admin e ler o perfil de todos os usuários. Ver
    // docs/auditoria-2026-09.md, item P0-1.
    //
    // Agora os privilégios são write-only pra admin: o dono cria o
    // próprio perfil com valores travados e depois só consegue mexer nas
    // flags denormalizadas de "tem chave cadastrada" (userSecrets.ts).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Primeiro login (ver ensureUserProfile em src/lib/userProfile.ts):
      // o próprio client cria o doc, mas com `isAdmin` e `plan` FIXOS no
      // valor inicial — não dá pra "nascer" admin nem com plano pago.
      // `hasOnly` nas chaves impede também injetar campo desconhecido.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['email', 'plan', 'isAdmin', 'createdAt'])
        && request.resource.data.isAdmin == false
        && request.resource.data.plan == 'free';

      // Dono atualiza SÓ as flags de chave cadastrada (escritas no mesmo
      // writeBatch de saveUser*ApiKey — ver userSecrets.ts). Qualquer
      // update que toque em isAdmin/plan/createdAt/email é recusado aqui
      // e só passa pela regra de admin logo abaixo. Isso também cobre,
      // de propósito, os campos de billing do Mercado Pago
      // (`mpPreapprovalId`/`mpSubscriptionStatus`/`mpSubscriptionUpdatedAt`,
      // ver api/billing-create-subscription.ts e api/billing-webhook.ts):
      // não estão no `hasOnly` acima, então o client nunca consegue
      // gravá-los direto — só o Admin SDK (que ignora esta regra) escreve,
      // depois de confirmar o status na própria API do Mercado Pago.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hasSerpApiKey', 'hasRapidApiKey', 'hasSearchApiKey',
          'hasUnwrangleApiKey', 'hasGeminiApiKey', 'hasMistralApiKey'
        ]);

      // Exclusão da própria conta (src/lib/auth.ts > deleteAccount) —
      // continua permitida ao dono, é ele apagando os próprios dados.
      allow delete: if isOwner(userId);

      // Admin: troca de plano e concessão/remoção de admin (Admin.tsx >
      // updateUserPlan/updateUserAdmin). É o ÚNICO caminho que consegue
      // escrever isAdmin/plan.
      allow update: if isAdmin();

      // Regras de precificação — era `pricing_rules/{userId}`.
      match /pricing_rules/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Preferências de UI (Configurações → Aparência/Personalização, ver
      // src/lib/userPreferences.ts) — tema, paleta, tamanho de fonte,
      // toggles de gráfico e as "Preferências opcionais" da tela Conta.
      // Mesmo padrão de `pricing_rules` acima: doc único por usuário, sem
      // override de admin (não é dado de gestão de plano).
      match /preferences/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Chave SerpApi/RapidAPI (BYOK, ver userSecrets.ts) — era
      // `user_secrets/{userId}`. Deliberadamente SEM override de admin —
      // é credencial do usuário, não dado de gestão de plano (diferente
      // do doc de perfil acima).
      match /secrets/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Histórico de uploads (PDF/CSV processados) — era
      // `catalog_uploads/{uploadId}` com campo `userId`. Escrito direto
      // pelo client (não pelo Admin SDK), por isso a regra de fato
      // importa aqui. Admin tem `read` (só leitura, nunca write) —
      // sustenta a tela de detalhe por usuário no Admin (ADR-0002,
      // Action Item 1); dado em si continua owner-only pra update/delete.
      match /catalog_uploads/{uploadId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }

      // Hospedagem temporária de foto de produto pro modo imagem (Google
      // Lens, ver src/lib/catalogImages.ts) — era `catalog_images/{id}`
      // com campo `userId`. Só criação/leitura pelo próprio usuário (uma
      // foto por vez, nunca atualizada). Leitura pública real acontece
      // via api/catalog-image.ts com o Admin SDK (ignora esta regra de
      // propósito, já que o crawler do Google Lens não manda
      // Authorization header nenhum) — por isso `read` aqui fica
      // restrito ao dono mesmo, só pra não abrir a subcoleção sem
      // necessidade.
      match /catalog_images/{imageId} {
        allow create, read: if isOwner(userId);
        allow update, delete: if false;
      }

      // Contador de buscas do dia (Fase Planos — enforcement de cota por
      // plano) — era `usage_daily/{uid}_{yyyymmdd}` (ID composto só pra
      // isolar sem subcoleção). Doc ID agora é só a data
      // (`{yyyymmdd}`, ver usageQuota.ts), o path já isola por usuário.
      // Admin tem `read` (só leitura) pra tela de detalhe por usuário
      // (ADR-0002, Action Item 1) — write continua exclusivo do dono.
      match /usage_daily/{dayId} {
        allow read: if isOwner(userId);
        allow read: if isAdmin();
        // Escrita SÓ pelo servidor (Admin SDK ignora Security Rules) —
        // ver api/_lib/searchQuota.ts. Antes o próprio dono escrevia este
        // contador, o que anulava qualquer teto: bastava não incrementar
        // (ou zerar o doc) pra seguir buscando de graça, inclusive nos
        // mecanismos pagos pela plataforma (SCRAPERAPI_KEY). Ver
        // docs/auditoria-2026-09.md > P0-3.
        allow write: if false;
      }

      // Cache de preços (era `market_prices/{document}`, coleção global
      // — ver ADR-0003). Movido pra dentro de `users/{userId}` por
      // decisão explícita: a chave do cache é `provider__marketplace__sku`,
      // e SKU é texto arbitrário do catálogo de cada fornecedor — global,
      // dois usuários (ou dois catálogos do MESMO usuário) reaproveitando
      // o mesmo texto de SKU pra produtos DIFERENTES colidiam e um
      // herdava o preço do outro. Isolado por usuário elimina a colisão,
      // ao custo de perder o compartilhamento de cache entre contas. Só
      // o servidor escreve (Admin SDK ignora Security Rules; `write:
      // false` aqui só bloqueia escrita direta do client).
      match /market_prices/{document} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Índice `imageId -> { uid, expiresAt }` da foto de catálogo
    // (set/2026, ver src/lib/catalogImages.ts e api/catalog-image.ts).
    // Existe pra a URL pública da foto não carregar mais o UID do usuário
    // — ela é entregue a terceiros (SerpApi/SearchApi.io baixam a imagem
    // por ela). O dono só CRIA (apontando pro próprio uid); ler é
    // exclusividade do servidor (Admin SDK ignora estas regras), e
    // ninguém atualiza nem apaga — o documento expira sozinho pela TTL
    // policy configurada em `expiresAt`.
    match /catalog_image_index/{imageId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'expiresAt']);
      allow read, update, delete: if false;
    }

    // Tokens OAuth do Mercado Livre: só o Admin SDK (server, via
    // scripts/ml-oauth-setup.mjs e api/_lib/mlAuth.ts) lê/escreve — o
    // Admin SDK ignora Security Rules, então isso só bloqueia acesso
    // direto do client (onde o client_secret nunca deveria chegar). Não
    // é dado de usuário — token da aplicação como um todo.
    match /ml_oauth/{document} {
      allow read, write: if false;
    }

    // Biblioteca administrável de catálogos (Fase Planos): qualquer
    // usuário autenticado pode ler um catálogo se for admin OU se o
    // próprio plano estiver em `plans` do documento — o filtro por plano
    // é reforçado aqui, não só no client (`listSharedCatalogsForPlan`).
    // Só admin escreve (upload, atribuição de plano, exclusão). Indexado
    // por plano (`plans[]`), não por usuário — fica fora de `users/{uid}`
    // (ver ADR-0003).
    match /shared_catalogs/{catalogId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.plans.hasAny([get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan])
      );
      allow write: if isAdmin();
    }

    // Nega tudo que não foi listado explicitamente acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
